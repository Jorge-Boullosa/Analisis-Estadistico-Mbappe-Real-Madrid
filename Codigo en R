####modelo

df$victoria<- factor(df$victoria) # pasamos a factores las variables para la regresión
df$juega<- factor(df$juega)
df$nivel<- factor(df$nivel)
df$local_visitante<- factor(df$local_visitante)


modelo1 <- glm(victoria ~ competicion+local_visitante+nivel+juega+gol+asist,
              data = df,
              family = binomial)
modelo2<- glm(victoria ~ local_visitante+nivel+juega+gol,
               data = df,
               family = binomial)

summary(modelo1)
summary(modelo2)  # nos quedamos con el segundo modelo que explica mejor y es más simple (menos ruido)



#funcion para hallar probabilidades

calc<- function(f,m,v,j,g){
  z<- 0.7822+f*1.2448+m*2.1441-j*2.0632+g*1.8988-v*1.5309
  prob<- 1/(1+exp(-z))
  prob
}

calc(0,1,0,1,1) # partido media dificultad, de local, juega Mbappé y marca 1 gol
calc(0,0,1,1,1) # contra Bayern de Munich, fuera de casa, juega Mbappé y marca un gol (realidad)
calc(0,0,1,0,0) # contra Bayern de Munich, fuera de casa y sin Mbappé
calc(1,0,0,0,0) # contra Girona, en casa y sin Mbappé
calc(1,0,0,1,0) # contra Girona, en casa, juega Mbappé pero no marca (realidad)
